<%- include('../partials/public-header') %>

<div class="container" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 60px 16px;">
  <div style="max-width: 540px; width: 100%; text-align: center; background: var(--bg-white, #ffffff); border-radius: 16px; border: 1px solid var(--border-color, #e5e7eb); padding: 40px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
    
    <!-- Badge Erreur 500 -->
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 50%; background: rgba(220, 38, 38, 0.08); color: #dc2626; margin-bottom: 20px;">
      <i data-lucide="alert-triangle" style="width: 36px; height: 36px;"></i>
    </div>

    <span style="display: inline-block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: #dc2626; margin-bottom: 8px;">
      Erreur 500
    </span>

    <h1 style="font-size: 26px; font-weight: 800; color: var(--text-primary, #111827); margin-bottom: 12px; line-height: 1.3;">
      Incident temporaire
    </h1>

    <p style="font-size: 15px; color: var(--text-secondary, #6b7280); line-height: 1.6; margin-bottom: 28px;">
      Une difficulté technique temporaire est survenue sur notre serveur. Notre équipe est notifiée et s'emploie à rétablir le service au plus vite.
    </p>

    <!-- Actions -->
    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
      <a 
        href="https://wa.me/<%= whatsappNumber %>?text=Bonjour%20GQ%20Store%2C%20je%20rencontre%20un%20souci%20sur%20le%20site." 
        target="_blank" 
        rel="noopener noreferrer" 
        style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; min-height: 44px; border-radius: 8px; background: #25D366; color: white; text-decoration: none; font-weight: 600; font-size: 14px;"
      >
        <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i>
        <span>Contacter GQ Store sur WhatsApp</span>
      </a>
      <a 
        href="/" 
        style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; min-height: 44px; border-radius: 8px; background: var(--bg-neutral, #f3f4f6); color: var(--text-primary, #374151); text-decoration: none; font-weight: 600; font-size: 14px;"
      >
        <i data-lucide="home" style="width: 16px; height: 16px;"></i>
        <span>Retour à l'accueil</span>
      </a>
    </div>

  </div>
</div>

<%- include('../partials/public-footer') %>
