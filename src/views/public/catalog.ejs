<%- include('../partials/public-header') %>

<div class="container">
  <!-- Breadcrumb & Page Title -->
  <div style="padding-top: 24px;">
    <% 
      const matchedCategory = (typeof currentCategory !== 'undefined' && currentCategory) ? currentCategory : (filters.category ? categories.find(c => c.slug === filters.category) : null);
    %>
    <div style="font-size: 13px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">
      <a href="/">Accueil</a>
      <span>/</span>
      <a href="/catalogue" style="<%= !matchedCategory ? 'color: var(--gq-purple); font-weight: 600;' : '' %>">Catalogue</a>
      <% if (matchedCategory) { %>
        <span>/</span>
        <span style="color: var(--gq-purple); font-weight: 600;"><%= matchedCategory.name %></span>
      <% } %>
    </div>

    <div style="margin-top: 12px; margin-bottom: 20px;">
      <h1 style="font-size: 28px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
        <% if (matchedCategory) { %>
          <%= matchedCategory.name %>
        <% } else if (filters.q) { %>
          Résultats pour « <%= filters.q %> »
        <% } else { %>
          Tous nos Produits Informatiques
        <% } %>
      </h1>
      <p style="font-size: 14px; color: var(--text-secondary); margin-top: 4px;">
        <% if (matchedCategory && matchedCategory.description) { %>
          <%= matchedCategory.description %>
        <% } else { %>
          Explorez notre inventaire disponible et certifié avec garantie GQ Store.
        <% } %>
      </p>
    </div>
  </div>

  <div class="catalog-layout">
    
    <!-- Sidebar Desktop -->
    <aside class="catalog-sidebar">
      <form action="/catalogue" method="GET" id="desktopFilterForm">
        <!-- Maintenir la recherche textuelle -->
        <% if (filters.q) { %>
          <input type="hidden" name="q" value="<%= filters.q %>">
        <% } %>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
          <h3 style="font-size: 16px; font-weight: 700;">Filtres</h3>
          <a href="/catalogue" style="font-size: 12px; color: var(--gq-purple); font-weight: 600;">Réinitialiser</a>
        </div>

        <!-- Catégories -->
        <div class="filter-group">
          <h4 class="filter-group-title">Catégories</h4>
          <ul class="filter-list">
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %> onchange="this.form.submit()">
                  Toutes les catégories
                </span>
              </label>
            </li>
            <% categories.forEach(cat => { %>
              <li>
                <label class="filter-checkbox-label">
                  <span>
                    <input type="radio" name="category" value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'checked' : '' %> onchange="this.form.submit()">
                    <%= cat.name %>
                  </span>
                  <span class="filter-count"><%= cat._count.products %></span>
                </label>
              </li>
            <% }) %>
          </ul>
        </div>

        <!-- Marques -->
        <% if (brands && brands.length > 0) { %>
        <div class="filter-group">
          <h4 class="filter-group-title">Marques</h4>
          <ul class="filter-list">
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="brand" value="" <%= !filters.brand ? 'checked' : '' %> onchange="this.form.submit()">
                  Toutes les marques
                </span>
              </label>
            </li>
            <% brands.forEach(b => { %>
              <li>
                <label class="filter-checkbox-label">
                  <span>
                    <input type="radio" name="brand" value="<%= b.slug %>" <%= filters.brand === b.slug ? 'checked' : '' %> onchange="this.form.submit()">
                    <%= b.name %>
                  </span>
                  <span class="filter-count"><%= b._count.products %></span>
                </label>
              </li>
            <% }) %>
          </ul>
        </div>
        <% } %>

        <!-- État -->
        <% if (conditions && conditions.length > 0) { %>
        <div class="filter-group">
          <h4 class="filter-group-title">État</h4>
          <ul class="filter-list">
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="condition" value="" <%= !filters.condition ? 'checked' : '' %> onchange="this.form.submit()">
                  Tous les états
                </span>
              </label>
            </li>
            <% conditions.forEach(cond => { %>
              <li>
                <label class="filter-checkbox-label">
                  <span>
                    <input type="radio" name="condition" value="<%= cond %>" <%= filters.condition === cond ? 'checked' : '' %> onchange="this.form.submit()">
                    <%= cond %>
                  </span>
                </label>
              </li>
            <% }) %>
          </ul>
        </div>
        <% } %>

        <!-- Prix -->
        <div class="filter-group">
          <h4 class="filter-group-title">Prix (FCFA)</h4>
          <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
            <input 
              type="number" 
              name="minPrice" 
              placeholder="Min" 
              value="<%= filters.minPrice %>" 
              class="search-input" 
              style="padding: 6px 10px; font-size: 13px;"
            >
            <span style="color: var(--text-muted);">-</span>
            <input 
              type="number" 
              name="maxPrice" 
              placeholder="Max" 
              value="<%= filters.maxPrice %>" 
              class="search-input" 
              style="padding: 6px 10px; font-size: 13px;"
            >
          </div>
          <button type="submit" class="btn btn-secondary btn-sm btn-block">Appliquer le prix</button>
        </div>

        <!-- Disponibilité -->
        <div class="filter-group" style="border-bottom: none;">
          <label class="filter-checkbox-label" style="font-weight: 600; color: var(--text-primary);">
            <span>
              <input type="checkbox" name="inStock" value="1" <%= filters.inStock ? 'checked' : '' %> onchange="this.form.submit()">
              En stock uniquement
            </span>
          </label>
        </div>
      </form>
    </aside>

    <!-- Main Content -->
    <section class="catalog-main">
      
      <!-- Toolbar -->
      <div class="catalog-toolbar">
        <div class="catalog-count">
          <strong><%= pagination.totalCount %></strong> produit<%= pagination.totalCount > 1 ? 's' : '' %> trouvé<%= pagination.totalCount > 1 ? 's' : '' %>
          <% if (filters.q) { %>
            pour <span style="color: var(--gq-purple); font-weight: 600;">« <%= filters.q %> »</span>
          <% } %>
        </div>

        <div class="catalog-toolbar-actions">
          <!-- Mobile filter button -->
          <button type="button" class="mobile-filter-trigger" id="openFiltersBtn">
            <i data-lucide="sliders-horizontal" style="width: 16px; height: 16px;"></i>
            <span>Filtres</span>
          </button>

          <!-- Sort Select -->
          <label for="sortSelect" style="display: none;">Trier par</label>
          <select id="sortSelect" class="sort-select">
            <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Plus récents</option>
            <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Prix croissant</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Prix décroissant</option>
            <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Nom (A-Z)</option>
          </select>
        </div>
      </div>

      <!-- Active Filter Tags (if any) -->
      <% if (filters.q || filters.category || filters.brand || filters.condition || filters.minPrice || filters.maxPrice || filters.inStock) { %>
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
          <span style="font-size: 12px; color: var(--text-muted);">Filtres actifs :</span>
          <% if (filters.q) { %>
            <span class="badge-condition" style="display: inline-flex; align-items: center; gap: 4px;">
              Recherche: "<%= filters.q %>"
            </span>
          <% } %>
          <% if (filters.category) { %>
            <span class="badge-condition">Catégorie: <%= filters.category %></span>
          <% } %>
          <% if (filters.brand) { %>
            <span class="badge-condition">Marque: <%= filters.brand %></span>
          <% } %>
          <% if (filters.condition) { %>
            <span class="badge-condition">État: <%= filters.condition %></span>
          <% } %>
          <% if (filters.minPrice || filters.maxPrice) { %>
            <span class="badge-condition">
              Prix: <%= filters.minPrice ? formatFCFA(filters.minPrice) : '0' %> - <%= filters.maxPrice ? formatFCFA(filters.maxPrice) : 'Max' %>
            </span>
          <% } %>
          <% if (filters.inStock) { %>
            <span class="badge-condition">En stock</span>
          <% } %>
          <a href="/catalogue" style="font-size: 12px; color: var(--gq-purple); text-decoration: underline; margin-left: 4px;">Effacer tout</a>
        </div>
      <% } %>

      <!-- Products Grid or Empty State -->
      <% if (products && products.length > 0) { %>
        <div class="products-grid">
          <% products.forEach(prod => { %>
            <div class="product-card">
              <a href="/produits/<%= prod.slug %>" class="product-card-image-box" aria-label="<%= prod.name %>">
                <% if (prod.photos && prod.photos.length > 0) { %>
                  <img src="<%= prod.photos[0].url %>" alt="<%= prod.photos[0].alt || prod.name %>" class="product-card-image" loading="lazy" decoding="async">
                <% } else { %>
                  <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-muted); gap: 6px;">
                    <i data-lucide="image" style="width: 32px; height: 32px;"></i>
                    <span style="font-size: 11px;">GQ Store</span>
                  </div>
                <% } %>

                <div class="card-badge-top">
                  <% if (prod.stock > 0) { %>
                    <span class="badge-status badge-available">Disponible</span>
                  <% } else { %>
                    <span class="badge-status badge-out-of-stock">Rupture de stock</span>
                  <% } %>
                </div>
              </a>

              <div class="product-card-body">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <span class="product-card-brand"><%= prod.brand ? prod.brand.name : 'GQ Store' %></span>
                  <span class="badge-condition"><%= prod.condition %></span>
                </div>

                <a href="/produits/<%= prod.slug %>" class="product-card-title" title="<%= prod.name %>">
                  <%= prod.name %>
                </a>

                <div class="product-card-footer">
                  <div>
                    <% if (prod.promoPrice && prod.promoPrice < prod.price) { %>
                      <span class="product-card-price"><%= formatFCFA(prod.promoPrice) %></span>
                      <span class="product-card-promo-old"><%= formatFCFA(prod.price) %></span>
                    <% } else { %>
                      <span class="product-card-price"><%= formatFCFA(prod.price) %></span>
                    <% } %>
                  </div>

                  <div style="display: flex; gap: 6px; align-items: center;">
                    <% if (prod.stock > 0) { %>
                      <button 
                        type="button" 
                        class="btn btn-primary btn-sm" 
                        style="padding: 6px 10px;" 
                        title="Ajouter au panier" 
                        aria-label="Ajouter <%= prod.name %> au panier"
                        data-action="add-to-cart"
                        data-product-id="<%= prod.id %>"
                        data-product-name="<%= prod.name %>"
                        data-product-slug="<%= prod.slug %>"
                        data-product-ref="<%= prod.reference %>"
                        data-product-price="<%= (prod.promoPrice && prod.promoPrice < prod.price) ? prod.promoPrice : prod.price %>"
                        data-product-photo="<%= (prod.photos && prod.photos.length > 0) ? prod.photos[0].url : '' %>"
                        data-product-stock="<%= prod.stock %>"
                      >
                        <i data-lucide="shopping-bag" style="width: 14px; height: 14px;"></i>
                      </button>
                    <% } %>

                    <a href="/produits/<%= prod.slug %>" class="btn btn-outline-purple btn-sm" aria-label="Consulter <%= prod.name %>">
                      <span>Fiche</span>
                      <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 48px;">
            <% 
              // Construction URL helper
              function getPageUrl(p) {
                const params = new URLSearchParams();
                if (filters.q) params.set('q', filters.q);
                if (filters.category) params.set('category', filters.category);
                if (filters.brand) params.set('brand', filters.brand);
                if (filters.condition) params.set('condition', filters.condition);
                if (filters.minPrice) params.set('minPrice', filters.minPrice);
                if (filters.maxPrice) params.set('maxPrice', filters.maxPrice);
                if (filters.inStock) params.set('inStock', '1');
                if (filters.sort && filters.sort !== 'recent') params.set('sort', filters.sort);
                params.set('page', p);
                return '/catalogue?' + params.toString();
              }
            %>

            <% if (pagination.currentPage > 1) { %>
              <a href="<%= getPageUrl(pagination.currentPage - 1) %>" class="btn btn-secondary btn-sm">
                &larr; Précédent
              </a>
            <% } %>

            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <a 
                href="<%= getPageUrl(i) %>" 
                class="btn btn-sm <%= pagination.currentPage === i ? 'btn-primary' : 'btn-secondary' %>"
                style="min-width: 36px;"
              >
                <%= i %>
              </a>
            <% } %>

            <% if (pagination.currentPage < pagination.totalPages) { %>
              <a href="<%= getPageUrl(pagination.currentPage + 1) %>" class="btn btn-secondary btn-sm">
                Suivant &rarr;
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <!-- Empty State -->
        <div style="text-align: center; padding: 60px 20px; background: var(--bg-secondary); border-radius: var(--radius-lg); border: 1px dashed var(--border-color); margin-top: 20px;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-full); background: var(--gq-purple-subtle); color: var(--gq-purple); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <i data-lucide="search-x" style="width: 28px; height: 28px;"></i>
          </div>
          <h3 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">Aucun produit trouvé</h3>
          <p style="font-size: 14px; color: var(--text-secondary); max-width: 420px; margin: 0 auto 20px;">
            Aucun appareil ne correspond à votre sélection actuelle. Essayez d'élargir vos critères de recherche ou de réinitialiser vos filtres.
          </p>
          <a href="/catalogue" class="btn btn-primary">
            <i data-lucide="refresh-cw"></i>
            <span>Réinitialiser les filtres</span>
          </a>
        </div>
      <% } %>

    </section>
  </div>
</div>

<!-- Mobile Filter Drawer -->
<div class="filter-drawer" id="filterDrawer">
  <div class="filter-drawer-content">
    <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px;">
      <h3 style="font-size: 18px; font-weight: 700;">Filtrer le catalogue</h3>
      <button type="button" id="closeFiltersBtn" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-secondary);">
        <i data-lucide="x"></i>
      </button>
    </div>

    <form action="/catalogue" method="GET">
      <% if (filters.q) { %>
        <input type="hidden" name="q" value="<%= filters.q %>">
      <% } %>

      <!-- Catégories Mobile -->
      <div class="filter-group">
        <h4 class="filter-group-title">Catégories</h4>
        <ul class="filter-list">
          <li>
            <label class="filter-checkbox-label">
              <span>
                <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %>>
                Toutes les catégories
              </span>
            </label>
          </li>
          <% categories.forEach(cat => { %>
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="category" value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'checked' : '' %>>
                  <%= cat.name %>
                </span>
                <span class="filter-count"><%= cat._count.products %></span>
              </label>
            </li>
          <% }) %>
        </ul>
      </div>

      <!-- Marques Mobile -->
      <% if (brands && brands.length > 0) { %>
      <div class="filter-group">
        <h4 class="filter-group-title">Marques</h4>
        <ul class="filter-list">
          <li>
            <label class="filter-checkbox-label">
              <span>
                <input type="radio" name="brand" value="" <%= !filters.brand ? 'checked' : '' %>>
                Toutes les marques
              </span>
            </label>
          </li>
          <% brands.forEach(b => { %>
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="brand" value="<%= b.slug %>" <%= filters.brand === b.slug ? 'checked' : '' %>>
                  <%= b.name %>
                </span>
                <span class="filter-count"><%= b._count.products %></span>
              </label>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <!-- État Mobile -->
      <% if (conditions && conditions.length > 0) { %>
      <div class="filter-group">
        <h4 class="filter-group-title">État</h4>
        <ul class="filter-list">
          <li>
            <label class="filter-checkbox-label">
              <span>
                <input type="radio" name="condition" value="" <%= !filters.condition ? 'checked' : '' %>>
                Tous les états
              </span>
            </label>
          </li>
          <% conditions.forEach(cond => { %>
            <li>
              <label class="filter-checkbox-label">
                <span>
                  <input type="radio" name="condition" value="<%= cond %>" <%= filters.condition === cond ? 'checked' : '' %>>
                  <%= cond %>
                </span>
              </label>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <!-- Prix Mobile -->
      <div class="filter-group">
        <h4 class="filter-group-title">Prix (FCFA)</h4>
        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
          <input 
            type="number" 
            name="minPrice" 
            placeholder="Min" 
            value="<%= filters.minPrice %>" 
            class="search-input" 
            style="padding: 8px 10px; font-size: 14px;"
          >
          <span>-</span>
          <input 
            type="number" 
            name="maxPrice" 
            placeholder="Max" 
            value="<%= filters.maxPrice %>" 
            class="search-input" 
            style="padding: 8px 10px; font-size: 14px;"
          >
        </div>
      </div>

      <!-- Disponibilité Mobile -->
      <div class="filter-group">
        <label class="filter-checkbox-label" style="font-weight: 600; color: var(--text-primary);">
          <span>
            <input type="checkbox" name="inStock" value="1" <%= filters.inStock ? 'checked' : '' %>>
            En stock uniquement
          </span>
        </label>
      </div>

      <div style="display: flex; gap: 10px; margin-top: 24px; padding-bottom: 24px;">
        <a href="/catalogue" class="btn btn-secondary" style="flex: 1;">Réinitialiser</a>
        <button type="submit" class="btn btn-primary" style="flex: 1;">Appliquer</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/public-footer') %>
