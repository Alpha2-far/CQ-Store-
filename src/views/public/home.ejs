<!-- Bannière Call To Action Catalogue -->
<section class="catalogue-cta">
  <div class="container catalogue-cta-inner">
    <h2 style="font-size: 26px; font-weight: 800; margin-bottom: 12px; color: #FFFFFF;">Vous cherchez une configuration spécifique ?</h2>
    <p style="font-size: 15px; opacity: 0.9; line-height: 1.6; margin-bottom: 24px;">
      Explorez l'intégralité de nos stocks avec nos filtres multicritères : marque, plage de prix, état neuf ou reconditionné.
    </p>
    <a href="/catalogue" class="btn" style="background: #FFFFFF; color: var(--gq-purple); font-weight: 700;">
      <i data-lucide="search"></i>
      <span>Accéder au catalogue complet</span>
    </a>
  </div>
</section>

<%- include('../partials/public-footer') %>
