<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Catégories de produits</h1>
    <p class="page-subtitle">Organisez l'arborescence et le menu de navigation de votre catalogue</p>
  </div>
  <div class="page-actions">
    <a href="/admin/categories/new" class="btn btn-primary">
      <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
      <span>Nouvelle catégorie</span>
    </a>
  </div>
</div>

<div class="card">
  <% if (categories.length === 0) { %>
    <div style="text-align: center; padding: 40px 16px; color: var(--text-secondary);">
      <i data-lucide="folder-plus" style="width: 40px; height: 40px; stroke-width: 1.5; margin-bottom: 8px;"></i>
      <p>Aucune catégorie créée pour le moment.</p>
      <a href="/admin/categories/new" class="btn btn-primary btn-sm" style="margin-top: 12px;">Créer la première catégorie</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 60px;">Ordre</th>
            <th>Nom de la catégorie</th>
            <th>Adresse URL (Slug)</th>
            <th>Produits associés</th>
            <th>Statut</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(category => { %>
            <tr>
              <td style="font-weight: 600; color: var(--text-secondary);"><%= category.position %></td>
              <td>
                <div style="font-weight: 600; color: var(--text-primary);"><%= category.name %></div>
                <% if (category.description) { %>
                  <div style="font-size: 12px; color: var(--text-secondary); max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= category.description %></div>
                <% } %>
              </td>
              <td>
                <code style="font-size: 12px; background: var(--bg-secondary); padding: 3px 6px; border-radius: var(--radius-sm);"><%= category.slug %></code>
              </td>
              <td>
                <span class="badge badge-purple"><%= category._count.products %> produit(s)</span>
              </td>
              <td>
                <% if (category.isVisible) { %>
                  <span class="badge badge-success">Visible</span>
                <% } else { %>
                  <span class="badge badge-gray">Masquée</span>
                <% } %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <form action="/admin/categories/<%= category.id %>/toggle-visibility" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-secondary btn-sm" title="<%= category.isVisible ? 'Masquer' : 'Rendre visible' %>">
                      <i data-lucide="<%= category.isVisible ? 'eye-off' : 'eye' %>" style="width: 15px; height: 15px;"></i>
                    </button>
                  </form>
                  <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-secondary btn-sm" title="Modifier">
                    <i data-lucide="edit-3" style="width: 15px; height: 15px;"></i>
                  </a>
                  <form action="/admin/categories/<%= category.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');">
                    <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                      <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
